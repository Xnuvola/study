        },
        "flooding-enhanced": {
            "type": "video",
            "path": "emotional-vs-responses/assets/flooding-enhanced.mov",
            "forceCompletion": true,
            "response": []
        },
        "first-visualization": {
            "type": "questionnaire",
            "response": [
                {
                    "id": "visualization-statements",
                    "prompt": "Look at the first visualization carefully. Answer the questions below.",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "matrix-radio",
                    "answerOptions": [
                        "Strongly disagree",
                        "Disagree",
                        "Slightly disagree",
                        "Neutral",
                        "Slightly agree",
                        "Agree",
                        "Strongly aagree"
                    ],
                "questionOptions": [
                "It is obvious for me how to read this visualization.",
                "I can easily understand how the data is represented in this visualization.",
                "I can easily understand this visualization.",
                "I don't find this visualization crowded.",
                "I don't find distracting parts in this visualization.",
                "I can easily find specific elements in this visualization.",
                "I can easily identify relevant information in this visualization.",
                "I can easily retrieve information from this visualization.",
                "I find data features (for example, a minimum, an outlier, or a trend) visible in this visualization.",
                "I can clearly see data features (for example, a minimum, an outlier, or a trend) in this visualization."
            ]
                },
                {
                    "id": "flooding-emotions",
                    "prompt": "What emotions do you associate with flooding now after you have viewed the visualization?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "checkbox",
                    "options": [
                        "Afraid",
                        "Alert",
                        "Upset",
                        "Interested",
                        "Distressed",
                        "Scared",
                        "Nervous"
                    ]
                },
                {
                    "id": "emotionally-affected",
                    "prompt": "Were you emotionally affected by the visualization?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "radio",
                    "options": [
                        "Yes",
                        "No"
                    ]
                },
                {
                    "id": "emotional-impact",
                    "prompt": "Indicate the extent to which you felt these emotions while viewing the visualization.",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "matrix-radio",
                    "answerOptions": [
                        "Very slightly or not at all",
                        "A little",
                        "Moderately",
                        "Quite a bit",
                        "Extremely"
                    ],
                    "questionOptions": [
                        "I felt overwhelmed by the flooding.",
                        "I felt anxious while watching the flooding progress.",
                        "I felt inspired to learn more about flooding.",
                        "I felt hopeful it would get better.",
                        "I felt inspired to act."
                    ]
                }
            ]
        },
