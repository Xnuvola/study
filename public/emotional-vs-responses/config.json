{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Emotional Responses of Data Visualization",
        "version": "pilot",
        "authors": [
            "The reVISit Team",
            "Enxhi"
        ],
        "date": "2026-02-23",
        "description": "This is a simple questionnair that will include in total 4 different visualization where each of them have their own set of questions",
        "organizations": [
            "University of Utah",
            "WPI",
            "University of Vienna"
        ]
    },
    "uiConfig": {
        "contactEmail": "your@email.com",
        "helpTextPath": "emotional-vs-responses/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "withSidebar": true
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "emotional-vs-responses/assets/introduction.md",
            "response": []
        },
        "demographics": {
            "type": "questionnaire",
            "response": [
                {
                    "id": "age",
                    "prompt": "What is your age?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "numerical",
                    "min": 18,
                    "max": 100,
                    "placeholder": "Enter your age"
                },
                {
                    "id": "gender",
                    "prompt": "What is your gender?",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "radio",
                    "options": [
                        "Female",
                        "Male",
                        "Other",
                        "Prefer not to say"
                    ]},
                    {
                        "id": "education",
                        "prompt": "What is your highest degree or level of education you have completed?",
                        "required": true,
                        "location": "aboveStimulus",
                        "type": "dropdown",
                        "placeholder": "Please select your highest level of education",
                        "options": [
                            "Less than high school degree",
                            "High school degree or equivalent",
                            "Professional/vocational degree",
                            "Some college/university study without earning a bachelor's degree",
                            "Bachelor's degree",
                            "Master's degree",
                            "Doctoral degree",
                            "Other"
                        ]
                    },
                    {
                        "id": "austrian-state",
                        "prompt": "In which Austrian federal state do you currently live?",
                        "required": true,
                        "location": "aboveStimulus",
                        "type": "dropdown",
                        "placeholder": "Please select your federal state",
                        "options": [
                            "Burgenland",
                            "Carinthia",
                            "Lower Austria",
                            "Upper Austria",
                            "Salzburg",
                            "Styria",
                            "Tyrol",
                            "Vorarlberg",
                            "Vienna"
                        ]
                    }
            ]
        },
        "second-question-set": {
            "type": "questionnaire",
            "response": [
                {
                    "id": "q3-satisfaction",
                    "prompt": "Rate your satisfaction with this survey from 1 (not enjoyable) to 5 (very enjoyable).",
                    "required": true,
                    "location": "aboveStimulus",
                    "type": "likert",
                    "leftLabel": "Not Enjoyable",
                    "rightLabel": "Very Enjoyable",
                    "numItems": 5
                }
            ]
        }
    },
    "sequence": {
        "order": "fixed",
        "components": [
            "introduction",
            "demographics",
            "second-question-set"
        ]
    }
}