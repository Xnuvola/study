                "location": "aboveStimulus",
                "type": "checkbox",
                "options": [
                    "Ängstlich",
                    "Alarmiert",
                    "Aufgebracht",
                    "Interessiert",
                    "Bedrückt",
                    "Verängstigt",
                    "Nervös"
                ]
