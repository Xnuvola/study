    "question_4-en": {
        "type": "questionnaire",
        "response": [
            {
                "id": "emotional-impact-en",
                "prompt": "Indicate the extent to which you felt these emotions while viewing the visualization.",
                "required": true,
                "location": "aboveStimulus",
                "type": "matrix-radio",
                "answerOptions": [
                    "Very slightly or not at all",
                    "A little",
                    "Moderately",
                    "Quite a bit",
                    "Extremely"
