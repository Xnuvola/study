    "question_1-en": {
        "type": "questionnaire",
        "response": [
            {
                "id": "visualization-statements-en",
                "prompt": "Look at the visualization carefully. Answer the questions below.",
                "required": true,
                "location": "aboveStimulus",
                "type": "matrix-radio",
                "answerOptions": [
                    "Strongly disagree",
                    "Disagree",
                    "Slightly disagree",
                    "Neutral",
                    "Slightly agree",
                    "Agree",
                    "Strongly agree"
                ],
                "questionOptions": [
                    "It is obvious for me how to read this visualization.",
                    "I can easily understand how the data is represented in this visualization.",
                    "I can easily understand this visualization.",
                    "I don't find this visualization crowded.",
                    "I don't find distracting parts in this visualization.",
                    "I can easily find specific elements in this visualization.",
                    "I can easily identify relevant information in this visualization.",
                    "I can easily retrieve information from this visualization.",
                    "I find data features (for example, a minimum, an outlier, or a trend) visible in this visualization.",
                    "I can clearly see data features (for example, a minimum, an outlier, or a trend) in this visualization."
                ]
            }
        ]
    },

    "question_1-de": {
        "type": "questionnaire",
        "response": [
            {
                "id": "visualization-statements-de",
                "prompt": "Betrachten Sie die Visualisierung aufmerksam. Beantworten Sie anschließend die folgenden Fragen.",
                "required": true,
                "location": "aboveStimulus",
                "type": "matrix-radio",
                "answerOptions": [
                    "Stimme überhaupt nicht zu",
                    "Stimme nicht zu",
                    "Stimme eher nicht zu",
                    "Neutral",
                    "Stimme eher zu",
                    "Stimme zu",
                    "Stimme voll und ganz zu"
                ],
                "questionOptions": [
                    "Für mich ist offensichtlich, wie diese Visualisierung zu lesen ist.",
                    "Ich kann leicht verstehen, wie die Daten in dieser Visualisierung dargestellt werden.",
                    "Ich kann diese Visualisierung leicht verstehen.",
                    "Ich finde diese Visualisierung nicht überladen.",
                    "Ich finde keine ablenkenden Elemente in dieser Visualisierung.",
                    "Ich kann bestimmte Elemente in dieser Visualisierung leicht finden.",
                    "Ich kann relevante Informationen in dieser Visualisierung leicht erkennen.",
                    "Ich kann Informationen aus dieser Visualisierung leicht abrufen.",
                    "Ich kann Datenmerkmale (z. B. ein Minimum, einen Ausreißer oder einen Trend) in dieser Visualisierung erkennen.",
                    "Ich kann Datenmerkmale (z. B. ein Minimum, einen Ausreißer oder einen Trend) in dieser Visualisierung deutlich erkennen."
                ]
            }
        ]
    },

    "question_2-en": {
        "type": "questionnaire",
        "response": [
            {
                "id": "flooding-emotions-en",
                "prompt": "What emotions do you associate with flooding now after you have viewed the visualization?",
                "required": true,
                "location": "aboveStimulus",
                "type": "checkbox",
                "options": [
                    "Afraid",
                    "Alert",
                    "Upset",
                    "Interested",
                    "Distressed",
                    "Scared",
                    "Nervous"
                ]
            }
        ]
    },

    "question_2-de": {
